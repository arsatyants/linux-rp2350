FROM debian:13

RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates patch git \
	make binutils gcc file wget cpio unzip rsync bc bzip2 g++ picotool && \
	rm -rf /var/lib/apt/lists/* && \
	apt-get clean

WORKDIR /root/pi-pico2-linux
# Use the LOCAL tree (with the RP2350-PiZero GPIO47 PSRAM CS fix already
# applied), not a fresh git clone of upstream.
COPY . .

ARG THREADS=1
# -j1: buildroot's dependency graph for this external tree has a real
# race at higher parallelism (host-patchelf gets invoked by target-finalize
# before its own build completes under -j4, causing a spurious "missing
# ELF header" failure). -j1 is slower but deterministic.
RUN make -C buildroot BR2_EXTERNAL=$PWD/ raspberrypi-pico2_defconfig && \
	make -C buildroot -j${THREADS}

CMD picotool load -fu buildroot/output/images/flash-image.uf2

# Build:  docker build --build-arg THREADS=4 -f Dockerfile.local -t pi-pico2-linux-pizero .
# Flash:  docker run --privileged -v /dev:/dev pi-pico2-linux-pizero
# Copy out built image:
#   docker create --name extract pi-pico2-linux-pizero
#   docker cp extract:/root/pi-pico2-linux/buildroot/output/images/flash-image.uf2 .
#   docker rm extract
